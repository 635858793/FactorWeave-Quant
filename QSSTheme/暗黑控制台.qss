/*
Dark Console Style Sheet for QT Applications
Author: Jaime A. Quiroga P.
Company: GTRONICK
Last updated: 24/05/2018, 17:12.
Available at: https://github.com/GTRONICK/QSS/blob/master/ConsoleStyle.qss
*/
QWidget {
	background-color: rgb(0, 0, 0);
	color: rgb(240, 240, 240);
	border-color: rgb(58, 58, 58);
}

QPlainTextEdit {
	background-color: rgb(0, 0, 0);
	color: rgb(200, 200, 200);
	selection-background-color: rgb(255, 153, 0);
	selection-color: rgb(0, 0, 0);
}

QTabWidget::pane {
	border-top: 1px solid #000000;
}

QTabBar::tab {
	background-color: rgb(0, 0, 0);
	border-style: outset;
	border-width: 1px;
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgba(231, 81, 81, 1);
	border-bottom-width: 1px;
	border-top-width: 0px;
	border-style: solid;
	color: rgb(255, 153, 0);
	padding: 4px;
}

QTabBar::tab:selected,
QTabBar::tab:hover {
	color: rgb(255, 255, 255);
	background-color: rgb(0, 0, 0);
	border-color: rgb(42, 42, 42);
	margin-left: 0px;
	margin-right: 0px;
	border-bottom-right-radius: 4px;
	border-bottom-left-radius: 4px;
}

QTabBar::tab:last:selected {
	background-color: rgb(0, 0, 0);
	border-color: rgb(42, 42, 42);
	margin-left: 0px;
	margin-right: 0px;
	border-bottom-right-radius: 4px;
	border-bottom-left-radius: 4px;
}

QTabBar::tab:!selected {
	margin-bottom: 4px;
	border-bottom-right-radius: 4px;
	border-bottom-left-radius: 4px;
}

QPushButton {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	min-height: 20px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
}

QPushButton:hover {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-bottom-color: rgb(115, 115, 115);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(107, 107, 107, 255), stop:1 rgba(157, 157, 157, 255));
}

QPushButton:pressed {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(62, 62, 62, 255), stop:1 rgba(22, 22, 22, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
}

QPushButton:disabled {
	border-style: outset;
	border-width: 1px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(0, 0, 0);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(57, 57, 57, 255), stop:1 rgba(77, 77, 77, 255));
}

/**********对话框按钮组**********/
QDialogButtonBox {
	background: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
	border: none;
}

QDialogButtonBox QPushButton {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	min-height: 20px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
}

QDialogButtonBox QPushButton:hover {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-bottom-color: rgb(115, 115, 115);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(107, 107, 107, 255), stop:1 rgba(157, 157, 157, 255));
}

QDialogButtonBox QPushButton:pressed {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(62, 62, 62, 255), stop:1 rgba(22, 22, 22, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
}

QDialogButtonBox QPushButton:disabled {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(0, 0, 0);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(57, 57, 57, 255), stop:1 rgba(77, 77, 77, 255));
}

QDialogButtonBox QPushButton:default {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-bottom-color: rgb(115, 115, 115);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(107, 107, 107, 255), stop:1 rgba(157, 157, 157, 255));
}

QLineEdit {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	padding: 0 8px;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
	selection-background-color: rgb(187, 187, 187);
	selection-color: rgb(60, 63, 65);
}

QProgressBar {
	text-align: center;
	color: rgb(255, 255, 255);
	border-width: 1px;
	border-radius: 10px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
}

QProgressBar::chunk {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(0, 200, 0, 255), stop:1 rgba(30, 230, 30, 255));
	border-radius: 10px;
}

QMenuBar {
	background: rgb(0, 0, 0);
	color: rgb(255, 153, 0);
}

QMenuBar::item {
	spacing: 3px;
	padding: 1px 4px;
	background: transparent;
}

QMenuBar::item:selected {
	background: rgb(115, 115, 115);
}

QMenu {
	border-width: 2px;
	border-radius: 10px;
	border-color: rgb(255, 153, 0);
	border-style: outset;
}

QMenu::item {
	spacing: 3px;
	padding: 3px 15px;
}

QMenu::item:selected {
	spacing: 3px;
	padding: 3px 15px;
	background: rgb(115, 115, 115);
	color: rgb(255, 255, 255);
	border-width: 1px;
	border-radius: 10px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
}

/* QFrame 框架样式 */
QFrame {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
}

QFrame#infoFrame {
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
	margin: 4px;
	padding: 4px;
}

/* QGroupBox 分组框样式 */
QGroupBox {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
	margin-top: 1.2em;
	padding-top: 10px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 5px;
	color: rgb(240, 240, 240);
}

QGroupBox::indicator {
	width: 18px;
	height: 18px;
	border-radius: 3px;
}

QGroupBox::indicator:unchecked {
	border: 1px solid rgb(58, 58, 58);
	background-color: transparent;
}

QGroupBox::indicator:checked {
	border: 1px solid rgb(255, 153, 0);
	background-color: rgb(255, 153, 0);
}

/* QSplitter 分裂器样式 */
QSplitter {
	background-color: rgb(0, 0, 0);
}

QSplitter::handle {
	background-color: rgb(42, 42, 42);
	border: 1px solid rgb(58, 58, 58);
}

QSplitter::handle:horizontal {
	width: 4px;
	margin: 2px;
}

QSplitter::handle:vertical {
	height: 4px;
	margin: 2px;
}

QSplitter::handle:hover {
	background-color: rgb(255, 153, 0);
}

/* QToolBar 工具栏样式 */
QToolBar {
	background-color: rgb(0, 0, 0);
	border-bottom: 1px solid rgb(58, 58, 58);
	spacing: 3px;
	padding: 2px;
}

QToolBar::separator {
	width: 1px;
	background-color: rgb(58, 58, 58);
	margin: 2px;
}

QToolBar QToolButton {
	background-color: transparent;
	border: 1px solid transparent;
	border-radius: 3px;
	padding: 3px;
}

QToolBar QToolButton:hover {
	background-color: rgb(42, 42, 42);
	border: 1px solid rgb(255, 153, 0);
}

QToolBar QToolButton:pressed {
	background-color: rgb(255, 153, 0);
}

/* QDockWidget 停靠窗口样式 */
QDockWidget {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
}

QDockWidget::title {
	text-align: center;
	background-color: rgb(42, 42, 42);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 3px;
	padding: 4px;
}

QDockWidget::close-button {
	background-color: rgb(42, 42, 42);
	border-radius: 2px;
}

QDockWidget::close-button:hover {
	background-color: #e74c3c;
}

QDockWidget::float-button {
	background-color: rgb(42, 42, 42);
	border-radius: 2px;
}

QDockWidget::float-button:hover {
	background-color: #3498db;
}

QDockWidget::separator {
	background-color: rgb(58, 58, 58);
	width: 1px;
	height: 1px;
}

QDockWidget QWidget {
	background-color: rgb(0, 0, 0);
}

/* QStackedWidget 堆叠窗口样式 */
QStackedWidget {
	background-color: rgb(0, 0, 0);
}

QStackedWidget QWidget {
	background-color: rgb(0, 0, 0);
}

/* QTableWidget 表格样式 */
QTableWidget {
	gridline-color: rgb(58, 58, 58);
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	alternate-background-color: rgb(42, 42, 42);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QTableWidget::item {
	padding: 4px;
	border: 1px solid transparent;
}

QTableWidget::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QTableWidget::item:hover {
	background-color: rgb(42, 42, 42);
}

QTableWidget QHeaderView {
	background-color: rgb(42, 42, 42);
}

QTableWidget QHeaderView::section {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	padding: 4px;
	font-weight: bold;
}

QTableWidget QHeaderView::section:checked {
	background-color: rgb(255, 153, 0);
}

/* QTableView 表格视图样式 */
QTableView {
	gridline-color: rgb(58, 58, 58);
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	alternate-background-color: rgb(42, 42, 42);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QTableView::item {
	padding: 4px;
	border: 1px solid transparent;
}

QTableView::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QTableView QHeaderView {
	background-color: rgb(42, 42, 42);
}

QTableView QHeaderView::section {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	padding: 4px;
	font-weight: bold;
}

/* QHeaderView 表头视图样式 */
QHeaderView {
	background-color: rgb(42, 42, 42);
}

QHeaderView::section {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	padding: 4px 8px;
	font-weight: bold;
}

QHeaderView::section:first {
	border-left: 1px solid rgb(42, 42, 42);
}

QHeaderView::section:last {
	border-right: 1px solid rgb(42, 42, 42);
}

QHeaderView::section:checked {
	background-color: rgb(255, 153, 0);
}

QHeaderView::section:hover {
	background-color: rgb(62, 62, 62);
}

QHeaderView::down-arrow {
	image: url(./icons/down.png);
	width: 12px;
	height: 12px;
}

QHeaderView::up-arrow {
	image: url(./icons/up.png);
	width: 12px;
	height: 12px;
}

/* QTreeWidget 树形控件样式 */
QTreeWidget {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QTreeWidget::item {
	padding: 3px;
	margin: 1px;
}

QTreeWidget::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QTreeWidget::item:hover {
	background-color: rgb(42, 42, 42);
}

QTreeWidget::branch {
	background-color: rgb(0, 0, 0);
}

QTreeWidget::branch:has-children:closed {
	image: url(./icons/branch-closed.png);
}

QTreeWidget::branch:has-children:open {
	image: url(./icons/branch-open.png);
}

QTreeWidget::branch:has-children:closed:hover {
	image: url(./icons/branch-closed-hover.png);
}

QTreeWidget::branch:has-children:open:hover {
	image: url(./icons/branch-open-hover.png);
}

QTreeWidget QHeaderView {
	background-color: rgb(42, 42, 42);
}

QTreeWidget QHeaderView::section {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	padding: 4px;
	font-weight: bold;
}

/* QTreeView 树形视图样式 */
QTreeView {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QTreeView::item {
	padding: 3px;
	margin: 1px;
}

QTreeView::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QTreeView::item:hover {
	background-color: rgb(42, 42, 42);
}

QTreeView::branch {
	background-color: rgb(0, 0, 0);
}

QTreeView::branch:has-children:closed {
	image: url(./icons/branch-closed.png);
}

QTreeView::branch:has-children:open {
	image: url(./icons/branch-open.png);
}

QTreeView QHeaderView {
	background-color: rgb(42, 42, 42);
}

QTreeView QHeaderView::section {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	padding: 4px;
	font-weight: bold;
}

/* QListWidget 列表控件样式 */
QListWidget {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QListWidget::item {
	padding: 6px;
	margin: 1px;
	border-radius: 3px;
}

QListWidget::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QListWidget::item:hover {
	background-color: rgb(42, 42, 42);
}

/* QListView 列表视图样式 */
QListView {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QListView::item {
	padding: 6px;
	margin: 1px;
	border-radius: 3px;
}

QListView::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QListView::item:hover {
	background-color: rgb(42, 42, 42);
}

/* QTextBrowser 文本浏览器样式 */
QTextBrowser {
	color: rgb(200, 200, 200);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QTextBrowser:hover {
	border-color: rgb(255, 153, 0);
}

/* QCalendarWidget 日历控件样式 */
QCalendarWidget {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
}

QCalendarWidget QToolButton {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
	padding: 4px;
}

QCalendarWidget QToolButton:hover {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QCalendarWidget QToolButton::menu-indicator {
	image: none;
}

QCalendarWidget QSpinBox {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
}

QCalendarWidget #qt_calendar_navigationbar {
	background-color: rgb(42, 42, 42);
}

QCalendarWidget #qt_calendar_prevmonth {
	qproperty-icon: url(./icons/left.png);
}

QCalendarWidget #qt_calendar_nextmonth {
	qproperty-icon: url(./icons/right.png);
}

QCalendarWidget QAbstractItemView:enabled {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	selection-background-color: rgb(255, 153, 0);
	selection-color: rgb(0, 0, 0);
}

QCalendarWidget QAbstractItemView:disabled {
	color: rgb(100, 100, 100);
}

/* QCheckBox 样式 */
QCheckBox {
	color: rgb(240, 240, 240);
	padding: 2px;
}

QCheckBox:disabled {
	color: rgb(100, 100, 100);
	padding: 2px;
}

QCheckBox::indicator:checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: rgb(255, 153, 0);
	color: rgb(240, 240, 240);
	background-color: rgb(255, 153, 0);
}

QCheckBox::indicator:unchecked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	color: rgb(240, 240, 240);
	background-color: transparent;
}

/* QRadioButton 样式 */
QRadioButton {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	padding: 2px;
}

QRadioButton:disabled {
	color: rgb(100, 100, 100);
	padding: 2px;
}

QRadioButton::indicator:checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: rgb(255, 153, 0);
	color: rgb(240, 240, 240);
	background-color: rgb(255, 153, 0);
	border-radius: 9px;
}

QRadioButton::indicator:!checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: rgb(58, 58, 58);
	color: rgb(240, 240, 240);
	background-color: transparent;
	border-radius: 9px;
}

/* QComboBox 下拉列表样式 */
QComboBox {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
	padding: 4px;
	min-height: 25px;
}

QComboBox::drop-down {
	border: none;
	width: 20px;
}

QComboBox::down-arrow {
	image: url(./icons/down.png);
	width: 12px;
	height: 12px;
}

QComboBox QAbstractItemView {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: solid;
	color: rgb(255, 255, 255);
	background: rgb(0, 0, 0);
	selection-background-color: rgb(255, 153, 0);
	selection-color: rgb(0, 0, 0);
}

QComboBox QAbstractItemView::item {
	padding: 4px;
}

QComboBox QAbstractItemView::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

/* QSpinBox 微调框样式 */
QSpinBox {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
	padding: 4px;
	min-height: 20px;
}

QSpinBox::up-button {
	border: none;
	background-color: rgb(42, 42, 42);
	width: 16px;
}

QSpinBox::up-button:hover {
	background-color: rgb(255, 153, 0);
}

QSpinBox::up-button:pressed {
	background-color: rgb(255, 153, 0);
}

QSpinBox::down-button {
	border: none;
	background-color: rgb(42, 42, 42);
	width: 16px;
}

QSpinBox::down-button:hover {
	background-color: rgb(255, 153, 0);
}

QSpinBox::down-button:pressed {
	background-color: rgb(255, 153, 0);
}

QSpinBox::up-arrow {
	image: url(./icons/up.png);
	width: 8px;
	height: 8px;
}

QSpinBox::down-arrow {
	image: url(./icons/down.png);
	width: 8px;
	height: 8px;
}

/* QDoubleSpinBox 双精度微调框样式 */
QDoubleSpinBox {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
	padding: 4px;
	min-height: 20px;
}

QDoubleSpinBox::up-button {
	border: none;
	background-color: rgb(42, 42, 42);
	width: 16px;
}

QDoubleSpinBox::up-button:hover {
	background-color: rgb(255, 153, 0);
}

QDoubleSpinBox::up-button:pressed {
	background-color: rgb(255, 153, 0);
}

QDoubleSpinBox::down-button {
	border: none;
	background-color: rgb(42, 42, 42);
	width: 16px;
}

QDoubleSpinBox::down-button:hover {
	background-color: rgb(255, 153, 0);
}

QDoubleSpinBox::down-button:pressed {
	background-color: rgb(255, 153, 0);
}

QDoubleSpinBox::up-arrow {
	image: url(./icons/up.png);
	width: 8px;
	height: 8px;
}

QDoubleSpinBox::down-arrow {
	image: url(./icons/down.png);
	width: 8px;
	height: 8px;
}

/* QSlider 滑块样式 */
QSlider::groove:horizontal {
	height: 8px;
	background: rgb(42, 42, 42);
	border-radius: 4px;
}

QSlider::handle:horizontal {
	width: 20px;
	height: 20px;
	background: rgb(255, 153, 0);
	border-radius: 10px;
	margin: -6px 0;
}

QSlider::handle:horizontal:hover {
	background: rgb(255, 200, 0);
}

QSlider::add-page:horizontal {
	background: rgb(42, 42, 42);
	border-radius: 4px;
}

QSlider::sub-page:horizontal {
	background: rgb(255, 153, 0);
	border-radius: 4px;
}

QSlider::groove:vertical {
	width: 8px;
	background: rgb(42, 42, 42);
	border-radius: 4px;
}

QSlider::handle:vertical {
	width: 20px;
	height: 20px;
	background: rgb(255, 153, 0);
	border-radius: 10px;
	margin: 0 -6px;
}

QSlider::handle:vertical:hover {
	background: rgb(255, 200, 0);
}

QSlider::add-page:vertical {
	background: rgb(42, 42, 42);
	border-radius: 4px;
}

QSlider::sub-page:vertical {
	background: rgb(255, 153, 0);
	border-radius: 4px;
}

/* QScrollBar 滚动条样式 */
QScrollBar:horizontal {
	height: 14px;
	background: rgb(0, 0, 0);
	border: 1px transparent grey;
	margin: 0px 20px 0px 20px;
	border-radius: 7px;
}

QScrollBar::handle:horizontal {
	background: rgb(42, 42, 42);
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-width: 30px;
	border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
	background: rgb(255, 153, 0);
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
}

QScrollBar::add-line:horizontal {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: rgb(42, 42, 42);
	width: 20px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 16px;
	width: 16px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 16px;
	width: 16px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: rgb(42, 42, 42);
	width: 20px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 16px;
	width: 16px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 16px;
	width: 16px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::left-arrow:horizontal {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::right-arrow:horizontal {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
	background: none;
}

QScrollBar:vertical {
	max-width: 14px;
	background: rgb(0, 0, 0);
	border: 1px transparent grey;
	margin: 20px 0px 20px 0px;
	border-radius: 7px;
}

QScrollBar::add-line:vertical {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: rgb(42, 42, 42);
	height: 14px;
	width: 14px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 14px;
	width: 14px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 14px;
	width: 14px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: rgb(42, 42, 42);
	height: 14px;
	width: 14px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 14px;
	width: 14px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(255, 153, 0);
	height: 14px;
	width: 14px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::handle:vertical {
	background-color: rgb(42, 42, 42);
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-height: 30px;
	border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
	background: rgb(255, 153, 0);
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-height: 30px;
}

QScrollBar::up-arrow:vertical {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::down-arrow:vertical {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
}

/* QScrollArea 滚动区域样式 */
QScrollArea {
	border: 1px solid rgb(58, 58, 58);
	background: rgb(0, 0, 0);
	border-radius: 4px;
}

/* QStatusBar 状态栏样式 */
QStatusBar {
	background-color: rgb(0, 0, 0);
	color: rgb(255, 153, 0);
	border-top: 1px solid rgb(58, 58, 58);
}

QStatusBar::item {
	border: none;
}

/* QToolButton 工具按钮样式 */
QToolButton {
	background-color: transparent;
	border: 1px solid transparent;
	border-radius: 3px;
	padding: 3px;
}

QToolButton:hover {
	background-color: rgb(42, 42, 42);
	border: 1px solid rgb(255, 153, 0);
}

QToolButton:pressed {
	background-color: rgb(255, 153, 0);
}

QToolButton::menu-button {
	border: 1px solid rgb(58, 58, 58);
	border-radius: 3px;
	background-color: rgb(42, 42, 42);
}

/* QLabel 标签样式 */
QLabel {
	color: rgb(240, 240, 240);
	background-color: transparent;
}

QLabel#titleLabel {
	font-size: 18px;
	font-weight: bold;
	color: rgb(255, 153, 0);
}

QLabel#accentLabel {
	color: rgb(255, 153, 0);
}

QLabel#grayLabel {
	color: rgb(150, 150, 150);
}

QLabel#errorLabel {
	color: rgb(231, 76, 60);
}

QLabel#successLabel {
	color: rgb(46, 204, 113);
}

QLabel#blueLabel {
	color: rgb(52, 152, 219);
}

QLabel#redLabel {
	color: rgb(231, 76, 60);
}

/* QDateEdit, QTimeEdit, QDateTimeEdit 日期时间编辑框样式 */
QDateEdit,
QTimeEdit {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	padding: 0 8px;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
}

QDateTimeEdit {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	padding: 0 8px;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
}

QDateEdit::drop-down,
QTimeEdit::drop-down,
QDateTimeEdit::drop-down {
	width: 20px;
	border: none;
}

QDateEdit QAbstractItemView,
QTimeEdit QAbstractItemView,
QDateTimeEdit QAbstractItemView {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: solid;
	color: rgb(255, 255, 255);
	background: rgb(0, 0, 0);
	selection-background-color: rgb(255, 153, 0);
	selection-color: rgb(0, 0, 0);
}

/* QTextEdit 文本编辑框样式 */
QTextEdit {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	padding: 4px;
	color: rgb(255, 255, 255);
	background: rgb(0, 0, 0);
}

/* QFileDialog 文件对话框样式 */
QFileDialog {
	background-color: rgb(0, 0, 0);
}

QFileDialog QListView {
	background: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QFileDialog QListView::item {
	color: rgb(240, 240, 240);
	padding: 5px;
}

QFileDialog QListView::item:selected {
	background: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QFileDialog QTreeView {
	background: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QFileDialog QTreeView::item:selected {
	background: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

/* QMessageBox 消息对话框样式 */
QMessageBox {
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QMessageBox QPushButton {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
	border-bottom-color: rgb(58, 58, 58);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	min-height: 20px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
}

QMessageBox QPushButton:hover {
	border-style: outset;
	border-width: 2px;
	border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
	border-bottom-color: rgb(115, 115, 115);
	border-bottom-width: 1px;
	border-style: solid;
	color: rgb(255, 255, 255);
	padding: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(107, 107, 107, 255), stop:1 rgba(157, 157, 157, 255));
}

/* QColorDialog 颜色对话框样式 */
QColorDialog {
	background-color: rgb(0, 0, 0);
}

QColorDialog QSpinBox {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
	min-height: 25px;
}

/* QFontDialog 字体对话框样式 */
QFontDialog {
	background-color: rgb(0, 0, 0);
}

QFontDialog QListView {
	background: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QFontDialog QListView::item:selected {
	background: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

/* QToolTip 工具提示样式 */
QToolTip {
	border: 1px solid rgb(255, 153, 0);
	background: rgb(0, 0, 0);
	color: rgb(255, 255, 255);
	padding: 5px;
	border-radius: 4px;
}

/* QLCDNumber LCD数字显示样式 */
QLCDNumber {
	color: rgb(255, 153, 0);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

/* QFontComboBox 字体选择框样式 */
QFontComboBox {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	color: rgb(255, 255, 255);
	background: rgb(101, 101, 101);
	padding: 4px;
	min-height: 25px;
}

QFontComboBox::drop-down {
	border: none;
	width: 20px;
}

QFontComboBox QAbstractItemView {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: solid;
	color: rgb(255, 255, 255);
	background: rgb(0, 0, 0);
	selection-background-color: rgb(255, 153, 0);
	selection-color: rgb(0, 0, 0);
}

QFontComboBox QAbstractItemView::item:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

/* QToolBox 工具箱样式 */
QToolBox {
	color: rgb(240, 240, 240);
	background-color: rgb(0, 0, 0);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 4px;
}

QToolBox::tab {
	background-color: rgb(42, 42, 42);
	color: rgb(240, 240, 240);
	border: 1px solid rgb(58, 58, 58);
	border-radius: 3px;
	padding: 6px;
}

QToolBox::tab:selected {
	background-color: rgb(255, 153, 0);
	color: rgb(0, 0, 0);
}

QToolBox::tab:hover {
	background-color: rgb(62, 62, 62);
}

/* QDial 拨盘样式 */
QDial {
	background-color: rgb(0, 0, 0);
}

QDial::groove {
	background: rgb(42, 42, 42);
	border-radius: 40px;
}

QDial::handle {
	width: 20px;
	height: 20px;
	background: rgb(255, 153, 0);
	border-radius: 10px;
}

QDial::handle:hover {
	background: rgb(255, 200, 0);
}

/* QProgressBar 进度条样式 (补充) */
QProgressBar {
	text-align: center;
	color: rgb(255, 255, 255);
	border-width: 1px;
	border-radius: 10px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
}

QProgressBar::chunk {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(0, 200, 0, 255), stop:1 rgba(30, 230, 30, 255));
	border-radius: 10px;
}

/* QMainWindow 主窗口样式 */
QMainWindow {
	background-color: rgb(0, 0, 0);
}

QMainWindow::separator {
	background: rgb(42, 42, 42);
	width: 4px;
	height: 4px;
}

QMainWindow::separator:hover {
	background: rgb(255, 153, 0);
}

/* QDialog 对话框样式 */
QDialog {
	background-color: rgb(0, 0, 0);
}