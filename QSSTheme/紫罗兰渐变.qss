/*---------------------------------------------------------------主要设置----------------------------------------------------------------*/

*{
  font-size:13px;
  color:white;
  font-family:"宋体";
}

QMainWindow::separator {
	background: rgb(112,112,112);
	width: 5px; /* when vertical */
	height: 5px; /* when horizontal */
}

QMenuBar {
	color: rgb(192,192,192);
	background-color: rgb(50,50,50);
}
QMenuBar::item {
	spacing: 3px; /* spacing between menu bar items */
	padding: 1px 4px;
	background: transparent;
	border-radius: 4px;
}
QMenuBar::item:selected { /* when selected using mouse or keyboard */
	background: #a8a8a8;
}
QMenuBar::item:pressed {
	background: #888888;
}
 
QToolTip {
    border: 2px solid darkkhaki;
    padding: 1px;
    border-radius: 3px;
}

.QToolBar {
     background: qlineargradient(spread:reflect, x1:0.5, y1:0.5, x2:0.5, y2:0, stop:0 rgba(0, 0, 0, 255), stop:1 rgba(170, 170, 170, 255));background-color: qlineargradient(spread:reflect, x1:0.5, y1:0.5, x2:0.5, y2:0, stop:0.20339 rgba(51, 51, 51, 255), stop:1 rgba(206, 206, 206, 255));
     spacing: 3px; /* spacing between items in the tool bar */
 }

/* Bold text on status bar looks awful. */
QStatusBar{
	background-color: rgb(112,112,112);
}
QStatusBar::item {
	border: 1px solid red;
	border-radius: 3px;
}

QDockWidget {
    border: 5px solid black;
}
QDockWidget::title {
	text-align: left; /* align the text to the left */
	background: darkgray;
	padding-left: 10px;
}
QDockWidget::close-button, QDockWidget::float-button {
	border: 1px solid transparent;
	background: darkgray;
	padding: 0px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
	background: gray;
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
	padding: 1px -1px -1px 1px;
}

QTreeView {
	background: rgb(50,50,50);
    show-decoration-selected: 1;
 }
QTreeView::item {
	color: rgb(232,232,232);
	border: 1px solid #d9d9d9;
	border-top-color: transparent;
	border-bottom-color: transparent;
}
QTreeView::item:hover {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #e7effd, stop: 1 #cbdaf1);
	border: 1px solid #bfcde4;
}
QTreeView::item:selected {
	border: 1px solid #567dbc;
}
QTreeView::item:selected:active{
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #6ea1f1, stop: 1 #567dbc);
}
QTreeView::item:selected:!active {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #6b9be8, stop: 1 #577fbf);
}

/**********主窗口**********/
QMainWindow {
        background: rgb(50, 50, 50);
}
QMainWindow::separator {
        background: rgb(80, 80, 80);
        width: 4px;
        height: 4px;
}
QMainWindow::separator:hover {
        background: rgb(150, 100, 200);
}

/**********菜单栏**********/
QMenuBar {
        color: rgb(200, 200, 200);
        background-color: rgb(45, 45, 45);
        border-bottom: 1px solid rgb(80, 80, 80);
}
QMenuBar::item {
        spacing: 3px;
        padding: 5px 10px;
        background: transparent;
        border-radius: 3px;
}
QMenuBar::item:selected {
        background: rgba(180, 130, 220, 150);
}
QMenuBar::item:pressed {
        background: rgba(180, 130, 220, 200);
}

/**********菜单**********/
QMenu {
        background-color: rgb(55, 55, 55);
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
}
QMenu::item {
        padding: 6px 25px 6px 20px;
        color: rgb(200, 200, 200);
}
QMenu::item:selected {
        background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8B5CB8, stop: 1 #9B6FC2);
        color: white;
}
QMenu::item:disabled {
        color: rgb(120, 120, 120);
}
QMenu::separator {
        height: 1px;
        background: rgb(80, 80, 80);
        margin: 3px 5px;
}
QMenu::indicator {
        width: 16px;
        height: 16px;
}

/**********工具栏**********/
QToolBar {
        background: rgb(55, 55, 55);
        border: 1px solid rgb(70, 70, 70);
        spacing: 5px;
        padding: 3px;
}
QToolBar::separator {
        width: 1px;
        background: rgb(100, 100, 100);
}
QToolBar::handle {
        width: 10px;
        background: rgb(100, 100, 100);
}

/**********状态栏**********/
QStatusBar {
        background-color: rgb(45, 45, 45);
        color: rgb(180, 180, 180);
}
QStatusBar::item {
        border: none;
        border-right: 1px solid rgb(80, 80, 80);
}

/**********滑块-水平**********/
QSlider::groove:horizontal {
        height: 8px;
        background: rgb(70, 70, 70);
        border-radius: 4px;
}
QSlider::handle:horizontal {
        width: 20px;
        height: 20px;
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
        border-radius: 10px;
        margin: -6px 0;
}
QSlider::handle:horizontal:hover {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #9B6CC8, stop: 1 #7B5AAE);
}
QSlider::add-page:horizontal {
        background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
        border-radius: 4px;
}
QSlider::sub-page:horizontal {
        background: rgb(100, 100, 100);
        border-radius: 4px;
}

/**********滑块-垂直**********/
QSlider::groove:vertical {
        width: 8px;
        background: rgb(70, 70, 70);
        border-radius: 4px;
}
QSlider::handle:vertical {
        width: 20px;
        height: 20px;
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
        border-radius: 10px;
        margin: 0 -6px;
}
QSlider::handle:vertical:hover {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #9B6CC8, stop: 1 #7B5AAE);
}
QSlider::add-page:vertical {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
        border-radius: 4px;
}
QSlider::sub-page:vertical {
        background: rgb(100, 100, 100);
        border-radius: 4px;
}

/**********进度条**********/
QProgressBar {
        border: 1px solid rgb(70, 70, 70);
        border-radius: 4px;
        text-align: center;
        color: rgb(200, 200, 200);
        background: rgb(50, 50, 50);
}
QProgressBar::chunk {
        background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8B5CB8, stop: 1 #9B6FC2);
        border-radius: 3px;
}

/**********标签页**********/
QTabWidget::pane {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(50, 50, 50);
        border-top: 3px solid #8B5CB8;
}
QTabBar::tab {
        background: rgb(60, 60, 60);
        color: rgb(180, 180, 180);
        padding: 8px 15px;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
}
QTabBar::tab:selected {
        background: rgb(50, 50, 50);
        color: white;
        border-top: 3px solid #8B5CB8;
}
QTabBar::tab:hover:!selected {
        background: rgba(180, 130, 220, 100);
}

/**********下拉列表**********/
QComboBox {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 3px 10px;
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QComboBox::drop-down {
        width: 20px;
        border: none;
        background: transparent;
}
QComboBox::down-arrow {
        image: url(:/Violet/arrowBottom);
}
QComboBox QAbstractItemView {
        background: rgb(55, 55, 55);
        border: 1px solid rgb(80, 80, 80);
        color: rgb(200, 200, 200);
}
QComboBox QAbstractItemView::item:selected {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
}

/**********微调框**********/
QSpinBox, QDoubleSpinBox {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 3px 5px;
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
        width: 18px;
        height: 12px;
        border-top-right-radius: 3px;
        border-left: 1px solid rgb(80, 80, 80);
        image: url(:/Violet/upButton);
        background: rgb(60, 60, 60);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
        width: 18px;
        height: 12px;
        border-bottom-right-radius: 3px;
        border-left: 1px solid rgb(80, 80, 80);
        image: url(:/Violet/downButton);
        background: rgb(60, 60, 60);
}

/**********输入框**********/
QLineEdit {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 4px 8px;
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QLineEdit:focus {
        border-color: #8B5CB8;
}

/**********文本编辑框**********/
QTextEdit {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}

QPlainTextEdit {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}

/**********文本浏览器**********/
QTextBrowser {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}

/**********复选框**********/
QCheckBox {
        spacing: 8px;
        color: rgb(200, 200, 200);
}
QCheckBox::indicator {
        width: 18px;
        height: 18px;
}

/**********单选框**********/
QRadioButton {
        spacing: 8px;
        color: rgb(200, 200, 200);
}
QRadioButton::indicator {
        width: 18px;
        height: 18px;
}

/**********分组框**********/
QGroupBox {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        margin-top: 12px;
        padding-top: 10px;
        color: rgb(180, 180, 180);
        font-weight: bold;
}
QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        color: rgb(180, 180, 180);
}

/**********表头**********/
QHeaderView {
        background: rgb(55, 55, 55);
        border: 1px solid rgb(70, 70, 70);
}
QHeaderView::section {
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
        padding: 5px;
        border: 1px solid rgb(70, 70, 70);
}
QHeaderView::section:hover {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
}

/**********表格视图**********/
QTableView {
        gridline-color: rgb(70, 70, 70);
        background: rgb(50, 50, 50);
}
QTableView::item {
        color: rgb(200, 200, 200);
        background: rgb(55, 55, 55);
        border: 1px solid rgb(70, 70, 70);
}
QTableView::item:selected {
        background: rgba(180, 130, 220, 150);
        color: white;
}

/**********列表控件**********/
QListWidget {
        background: rgb(50, 50, 50);
        border: 1px solid rgb(70, 70, 70);
}
QListWidget::item {
        color: rgb(200, 200, 200);
        background: rgb(55, 55, 55);
        padding: 5px;
        border: 1px solid rgb(70, 70, 70);
}
QListWidget::item:selected {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #8B5CB8, stop: 1 #6B4A9E);
        color: white;
}

/**********滚动条**********/
QScrollBar:horizontal {
        height: 14px;
        background: rgb(50, 50, 50);
        border-radius: 7px;
}
QScrollBar::handle:horizontal {
        background: rgb(80, 80, 80);
        border-radius: 6px;
        min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
        background: rgb(100, 100, 100);
}
QScrollBar:vertical {
        width: 14px;
        background: rgb(50, 50, 50);
        border-radius: 7px;
}
QScrollBar::handle:vertical {
        background: rgb(80, 80, 80);
        border-radius: 6px;
        min-height: 30px;
}
QScrollBar::handle:vertical:hover {
        background: rgb(100, 100, 100);
}

/**********按钮**********/
QPushButton {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 6px 15px;
        min-height: 25px;
        background: rgb(60, 60, 60);
        color: rgb(200, 200, 200);
}
QPushButton:hover {
        background: rgb(80, 80, 80);
}
QPushButton:pressed {
        background: rgb(100, 100, 100);
}
QPushButton:disabled {
        color: rgb(120, 120, 120);
        background: rgb(50, 50, 50);
}

/**********标签**********/
QLabel {
        color: rgb(200, 200, 200);
}
QLabel#titleLabel {
        font-size: 18px;
        font-weight: bold;
        color: rgb(220, 220, 220);
}
QLabel#accentLabel {
        color: #8B5CB8;
}
QLabel#errorLabel {
        color: rgb(200, 80, 80);
}
QLabel#successLabel {
        color: rgb(80, 180, 80);
}

/**********框架**********/
QFrame {
        background: rgb(50, 50, 50);
}
QFrame#infoFrame {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(55, 55, 55);
        border-radius: 4px;
}
QFrame[frameShape="4"] {
        background: rgb(80, 80, 80);
        max-height: 1px;
}
QFrame[frameShape="5"] {
        background: rgb(80, 80, 80);
        max-width: 1px;
}

/**********分割器**********/
QSplitter::handle {
        background: rgb(80, 80, 80);
}
QSplitter::handle:horizontal {
        width: 6px;
}
QSplitter::handle:vertical {
        height: 6px;
}
QSplitter::handle:hover {
        background: #8B5CB8;
}

/**********停靠窗口扩展**********/
QDockWidget {
        border: 1px solid rgb(80, 80, 80);
}
QDockWidget::title {
        background: rgb(60, 60, 60);
        padding: 5px 10px;
        color: rgb(200, 200, 200);
}
QDockWidget::close-button {
        background: transparent;
        border: none;
}
QDockWidget::float-button {
        background: transparent;
        border: none;
}

/**********堆叠窗口**********/
QStackedWidget {
        background: rgb(50, 50, 50);
}

/**********拨盘**********/
QDial {
        background: rgb(55, 55, 55);
}
QDial::groove {
        background: rgb(80, 80, 80);
        border-radius: 40px;
}
QDial::handle {
        width: 20px;
        height: 20px;
        background: #8B5CB8;
        border-radius: 10px;
}

/**********LCD数字显示**********/
QLCDNumber {
        background: rgb(50, 50, 50);
        color: #8B5CB8;
        border: 1px solid rgb(80, 80, 80);
}

/**********字体选择框**********/
QFontComboBox {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 3px;
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QFontComboBox::drop-down {
        width: 20px;
        background: transparent;
}
QFontComboBox QAbstractItemView {
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QFontComboBox QAbstractItemView::item:selected {
        background: #8B5CB8;
}

/**********日期时间编辑框**********/
QDateEdit, QTimeEdit {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 3px 5px;
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QDateEdit::drop-down, QTimeEdit::drop-down {
        width: 20px;
        background: transparent;
}
QDateTimeEdit {
        border: 1px solid rgb(80, 80, 80);
        border-radius: 4px;
        padding: 3px 5px;
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
}
QDateTimeEdit::drop-down {
        width: 20px;
        background: transparent;
}

/**********日历控件**********/
QCalendarWidget QAbstractItemView {
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
        selection-background-color: #8B5CB8;
        selection-color: white;
}

/**********工具提示扩展**********/
QToolTip {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(55, 55, 55);
        color: rgb(200, 200, 200);
        padding: 5px;
        border-radius: 4px;
}

/**********进度指示器**********/
QProgressIndicator {
        qproperty-color: #8B5CB8;
}

/**********大小调整手柄**********/
QSizeGrip {
        width: 16px;
        height: 16px;
}

/**********分页控件**********/
QPushButton#pageButton {
        min-width: 30px;
        padding: 5px 10px;
}
QPushButton#pageButton:checked {
        background: #8B5CB8;
        color: white;
}

/**********滚动区域**********/
QScrollArea {
        border: 1px solid rgb(80, 80, 80);
        background: rgb(50, 50, 50);
}