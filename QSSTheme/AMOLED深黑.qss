/*
AMOLED Style Sheet for QT Applications
Author: Jaime A. Quiroga P.
Company: GTRONICK
Last updated: 15/10/2019, 11:40.
Available at: https://github.com/GTRONICK/QSS/blob/master/AMOLED.qss
*/
QMainWindow {
	background-color: #000000;
}

QDialog {
	background-color: #000000;
}

QColorDialog {
	background-color: #000000;
}

QTextEdit {
	background-color: #000000;
	color: #a9b7c6;
}

QPlainTextEdit {
	selection-background-color: #f39c12;
	background-color: #000000;
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	color: #a9b7c6;
}

QPushButton {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #000000;
}

QPushButton::default {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-width: 1px;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #000000;
}

QPushButton:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-bottom-width: 1px;

	border-style: solid;
	color: #FFFFFF;
	padding-bottom: 2px;
	background-color: #000000;
}

QPushButton:pressed {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-bottom-width: 2px;

	border-style: solid;
	color: #e67e22;
	padding-bottom: 1px;
	background-color: #000000;
}

QPushButton:disabled {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-bottom-width: 2px;

	border-style: solid;
	color: #808086;
	padding-bottom: 1px;
	background-color: #000000;
}

/**********对话框按钮组**********/
QDialogButtonBox {
	background: #000000;
	border: none;
}

QDialogButtonBox QPushButton {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #000000;
}

QDialogButtonBox QPushButton:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-width: 1px;
	color: #a9b7c6;
	padding: 2px;
	background-color: #000000;
}

QDialogButtonBox QPushButton:pressed {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	background-color: #000000;
}

QDialogButtonBox QPushButton:disabled {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-bottom-width: 2px;
	border-style: solid;
	color: #808086;
	padding-bottom: 1px;
	background-color: #000000;
}

QDialogButtonBox QPushButton:default {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-width: 1px;
	color: #a9b7c6;
	padding: 2px;
	background-color: #000000;
}

QToolButton {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-bottom-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #000000;
}

QToolButton:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-bottom-width: 2px;

	border-style: solid;
	color: #FFFFFF;
	padding-bottom: 1px;
	background-color: #000000;
}

QLineEdit {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	padding: 0 8px;
	color: #a9b7c6;
	background: #000000;
	selection-background-color: #007b50;
	selection-color: #FFFFFF;
}

QLabel {
	color: #a9b7c6;
}

QLCDNumber {
	color: #e67e22;
}

QProgressBar {
	text-align: center;
	color: rgb(240, 240, 240);
	border-width: 1px;
	border-radius: 10px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	background-color: #000000;
}

QProgressBar::chunk {
	background-color: #e67e22;
	border-radius: 5px;
}

QMenu {
	background-color: #000000;
}

QMenuBar {
	background: rgb(0, 0, 0);
	color: #a9b7c6;
}

QMenuBar::item {
	spacing: 3px;
	padding: 1px 4px;
	background: transparent;
}

QMenuBar::item:selected {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-bottom-width: 1px;

	border-style: solid;
	color: #FFFFFF;
	padding-bottom: 0px;
	background-color: #000000;
}

QMenu::item:selected {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: #e67e22;
	border-bottom-color: transparent;
	border-left-width: 2px;
	color: #FFFFFF;
	padding-left: 15px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 7px;
	background-color: #000000;
}

QMenu::item {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-bottom-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding-left: 17px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 7px;
	background-color: #000000;
}

QTabWidget {
	color: rgb(0, 0, 0);
	background-color: #000000;
}

QTabWidget::pane {
	border-color: rgb(77, 77, 77);
	background-color: #000000;
	border-style: solid;
	border-width: 1px;
	border-radius: 6px;
}

QTabBar::tab {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-bottom-width: 1px;
	border-style: solid;
	color: #808086;
	padding: 3px;
	margin-left: 3px;
	background-color: #000000;
}

QTabBar::tab:selected,
QTabBar::tab:last:selected,
QTabBar::tab:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-bottom-width: 2px;
	border-style: solid;
	color: #FFFFFF;
	padding-left: 3px;
	padding-bottom: 2px;
	margin-left: 3px;
	background-color: #000000;
}

QCheckBox {
	color: #a9b7c6;
	padding: 2px;
}

QCheckBox:disabled {
	color: #808086;
	padding: 2px;
}

QCheckBox:hover {
	border-radius: 4px;
	border-style: solid;
	padding-left: 1px;
	padding-right: 1px;
	padding-bottom: 1px;
	padding-top: 1px;
	border-width: 1px;
	border-color: rgb(87, 97, 106);
	background-color: #000000;
}

QCheckBox::indicator:checked {

	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: #e67e22;
	color: #a9b7c6;
	background-color: #e67e22;
}

QCheckBox::indicator:unchecked {

	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: #e67e22;
	color: #a9b7c6;
	background-color: transparent;
}

QRadioButton {
	color: #a9b7c6;
	background-color: #000000;
	padding: 1px;
}

QRadioButton::indicator:checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-radius: 9px;
	border-width: 1px;
	border-color: #e67e22;
	color: #a9b7c6;
	background-color: #e67e22;
}

QRadioButton::indicator: !checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-radius: 9px;
	border-width: 1px;
	border-color: #e67e22;
	color: #a9b7c6;
	background-color: transparent;
}

QStatusBar {
	color: #027f7f;
}

QSpinBox {
	color: #a9b7c6;
	background-color: #000000;
}

QDoubleSpinBox {
	color: #a9b7c6;
	background-color: #000000;
}

QTimeEdit {
	color: #a9b7c6;
	background-color: #000000;
}

QDateTimeEdit {
	color: #a9b7c6;
	background-color: #000000;
}

QDateEdit {
	color: #a9b7c6;
	background-color: #000000;
}

QComboBox {
	color: #a9b7c6;
	background: #1e1d23;
}

QComboBox:editable {
	background: #1e1d23;
	color: #a9b7c6;
	selection-background-color: #000000;
}

QComboBox QAbstractItemView {
	color: #a9b7c6;
	background: #1e1d23;
	selection-color: #FFFFFF;
	selection-background-color: #000000;
}

QComboBox: !editable:on,
QComboBox::drop-down:editable:on {
	color: #a9b7c6;
	background: #1e1d23;
}

QFontComboBox {
	color: #a9b7c6;
	background-color: #000000;
}

QToolBox {
	color: #a9b7c6;
	background-color: #000000;
}

QToolBox::tab {
	color: #a9b7c6;
	background-color: #000000;
}

QToolBox::tab:selected {
	color: #FFFFFF;
	background-color: #000000;
}

QScrollArea {
	color: #FFFFFF;
	background-color: #000000;
}

QSlider::groove:horizontal {
	height: 8px;
	background: #e67e22;
}

QSlider::groove:vertical {
	width: 8px;
	background: #e67e22;
}

QSlider::handle:horizontal {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #b4b4b4, stop:1 #8f8f8f);
	border: 1px solid #5c5c5c;
	width: 20px;
	height: 20px;
	margin: -6px 0;
	border-radius: 10px;
}

QSlider::handle:vertical {
	background: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0 #b4b4b4, stop:1 #8f8f8f);
	border: 1px solid #5c5c5c;
	width: 20px;
	height: 20px;
	margin: 0 -6px;
	border-radius: 10px;
}

QSlider::add-page:horizontal {
	background: white;
}

QSlider::add-page:vertical {
	background: white;
}

QSlider::sub-page:horizontal {
	background: #e67e22;
}

QSlider::sub-page:vertical {
	background: #e67e22;
}

QScrollBar:horizontal {
	max-height: 20px;
	background: rgb(0, 0, 0);
	border: 1px transparent grey;
	margin: 0px 20px 0px 20px;
}

QScrollBar::handle:horizontal {
	background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(255, 0, 0, 0), stop:0.7 rgba(255, 0, 0, 0), stop:0.71 rgb(230, 126, 34), stop:1 rgb(230, 126, 34));
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-width: 25px;
}

QScrollBar::handle:horizontal:hover {
	background: rgb(230, 126, 34);
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-width: 25px;
}

QScrollBar::add-line:horizontal {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(255, 0, 0, 0), stop:0.7 rgba(255, 0, 0, 0), stop:0.71 rgb(230, 126, 34), stop:1 rgb(230, 126, 34));
	width: 20px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 16px;
	width: 16px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 16px;
	width: 16px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(255, 0, 0, 0), stop:0.7 rgba(255, 0, 0, 0), stop:0.71 rgb(230, 126, 34), stop:1 rgb(230, 126, 34));
	width: 20px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 16px;
	width: 16px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 16px;
	width: 16px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::left-arrow:horizontal {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::right-arrow:horizontal {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
	background: none;
}

QScrollBar:vertical {
	max-width: 14px;
	background: rgb(0, 0, 0);
	border: 1px transparent grey;
	margin: 20px 0px 20px 0px;
	border-radius: 7px;
}

QScrollBar::add-line:vertical {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(255, 0, 0, 0), stop:0.7 rgba(255, 0, 0, 0), stop:0.71 rgb(230, 126, 34), stop:1 rgb(230, 126, 34));
	height: 14px;
	width: 14px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 14px;
	width: 14px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 14px;
	width: 14px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(255, 0, 0, 0), stop:0.7 rgba(255, 0, 0, 0), stop:0.71 rgb(230, 126, 34), stop:1 rgb(230, 126, 34));
	height: 14px;
	width: 14px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover {
	border: 1px solid;
	border-color: rgb(0, 0, 0);
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 14px;
	width: 14px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:pressed {
	border: 1px solid;
	border-color: grey;
	border-radius: 8px;
	background: rgb(230, 126, 34);
	height: 14px;
	width: 14px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::handle:vertical {
	background-color: qlineargradient(x1:0, y1:0, x2:1, y2=0, stop:0 rgba(255, 0, 0, 0), stop:0.7 rgba(255, 0, 0, 0), stop:0.71 rgb(230, 126, 34), stop:1 rgb(230, 126, 34));
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-height: 30px;
	border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
	background: rgb(230, 126, 34);
	border-style: solid;
	border-width: 1px;
	border-color: rgb(0, 0, 0);
	min-height: 30px;
}

QScrollBar::up-arrow:vertical {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::down-arrow:vertical {
	border: 1px transparent grey;
	border-radius: 3px;
	width: 6px;
	height: 6px;
	background: rgb(0, 0, 0);
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
}

/* ==================== 补充缺失组件样式 ==================== */

/* QFrame 框架样式 */
QFrame {
	color: #a9b7c6;
	background-color: #000000;
}

QFrame[frameShape="0"] {
	border: none;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
	border-top: 1px solid #3a3a3a;
}

QFrame[frameShape="2"],
QFrame[frameShape="3"] {
	border-bottom: 1px solid #3a3a3a;
}

QFrame[frameShape="1"],
QFrame[frameShape="8"] {
	border-right: 1px solid #3a3a3a;
}

QFrame[frameShape="6"],
QFrame[frameShape="7"] {
	border-left: 1px solid #3a3a3a;
}

/* QGroupBox 分组框样式 */
QGroupBox {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
	margin-top: 1.2em;
	padding-top: 10px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	padding: 0 5px;
	color: #a9b7c6;
}

QGroupBox::indicator {
	width: 14px;
	height: 14px;
}

QGroupBox::indicator:unchecked {
	border: 1px solid #3a3a3a;
	background-color: #000000;
}

QGroupBox::indicator:checked {
	border: 1px solid #e67e22;
	background-color: #e67e22;
}

/* QSplitter 分割器样式 */
QSplitter {
	background-color: #000000;
}

QSplitter::handle {
	background-color: #1a1a1a;
	border: 1px solid #3a3a3a;
}

QSplitter::handle:horizontal {
	width: 4px;
	margin: 2px 0;
}

QSplitter::handle:vertical {
	height: 4px;
	margin: 0 2px;
}

QSplitter::handle:hover {
	background-color: #e67e22;
}

/* QToolBar 工具栏样式 */
QToolBar {
	background-color: #000000;
	border-bottom: 1px solid #3a3a3a;
	padding: 2px;
	spacing: 3px;
}

QToolBar::separator {
	width: 1px;
	background-color: #3a3a3a;
	margin: 0 3px;
}

/* QDockWidget 停靠窗口样式 */
QDockWidget {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
}

QDockWidget::title {
	background-color: #1a1a1a;
	color: #a9b7c6;
	padding: 6px 10px;
	border-bottom: 1px solid #3a3a3a;
}

QDockWidget::close-button,
QDockWidget::float-button {
	background-color: #1a1a1a;
	border: none;
	color: #a9b7c6;
	min-width: 16px;
	max-width: 16px;
	min-height: 16px;
	max-height: 16px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
	background-color: #e67e22;
	color: #000000;
}

/* QStackedWidget 堆叠窗口样式 */
QStackedWidget {
	background-color: #000000;
}

/* QTableWidget 表格样式 */
QTableWidget {
	color: #a9b7c6;
	background-color: #000000;
	gridline-color: #3a3a3a;
	selection-background-color: #1a3a4a;
	selection-color: #FFFFFF;
	border: 1px solid #3a3a3a;
}

QTableWidget::item {
	padding: 4px;
	border-right: 1px solid #3a3a3a;
	border-bottom: 1px solid #3a3a3a;
}

QTableWidget::item:selected {
	background-color: #1a3a4a;
	color: #FFFFFF;
}

/* QTableView 表格视图样式 */
QTableView {
	color: #a9b7c6;
	background-color: #000000;
	gridline-color: #3a3a3a;
	selection-background-color: #1a3a4a;
	selection-color: #FFFFFF;
	border: 1px solid #3a3a3a;
}

QTableView::item {
	padding: 4px;
}

QTableView::item:selected {
	background-color: #1a3a4a;
	color: #FFFFFF;
}

/* QHeaderView 表头样式 */
QHeaderView {
	background-color: #1a1a1a;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
}

QHeaderView::section {
	background-color: #1a1a1a;
	color: #a9b7c6;
	padding: 4px 8px;
	border: 1px solid #3a3a3a;
}

QHeaderView::section:checked {
	background-color: #2a2a2a;
	color: #e67e22;
}

QHeaderView::down-arrow {
	image: url(qss/down_arrow.png);
	width: 10px;
	height: 10px;
}

QHeaderView::up-arrow {
	image: url(qss/up_arrow.png);
	width: 10px;
	height: 10px;
}

/* QTreeWidget 树形控件样式 */
QTreeWidget {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
}

QTreeWidget::item {
	padding: 4px;
}

QTreeWidget::item:has-children {
	min-width: 16px;
	min-height: 16px;
}

QTreeWidget::item:selected {
	background-color: #1a3a4a;
	color: #FFFFFF;
}

QTreeWidget::item:hover {
	background-color: #1a2a3a;
}

QTreeWidget::branch {
	background-color: #000000;
}

QTreeWidget::branch:has-siblings: !adjoins-item {
	background-color: #000000;
}

QTreeWidget::branch:has-siblings:adjoins-item {
	background-color: #000000;
}

QTreeWidget::branch: !has-children: !has-siblings:adjoins-item {
	background-color: #000000;
}

QTreeWidget::branch:has-children: !has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
	image: url(qss/branch-closed.png);
}

QTreeWidget::branch:open:has-children: !has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
	image: url(qss/branch-open.png);
}

/* QTreeView 树形视图样式 */
QTreeView {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
	alternating-row-colors: true;
}

QTreeView::item {
	padding: 4px;
}

QTreeView::item:selected {
	background-color: #1a3a4a;
	color: #FFFFFF;
}

QTreeView::item:hover {
	background-color: #1a2a3a;
}

/* QListWidget 列表控件样式 */
QListWidget {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
	alternate-background-color: #0a0a0a;
}

QListWidget::item {
	padding: 6px 10px;
}

QListWidget::item:selected {
	background-color: #1a3a4a;
	color: #FFFFFF;
	border: 1px solid #e67e22;
}

QListWidget::item:hover {
	background-color: #1a2a3a;
}

/* QListView 列表视图样式 */
QListView {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
	alternating-row-colors: true;
	selection-background-color: #1a3a4a;
	selection-color: #FFFFFF;
}

QListView::item {
	padding: 6px 10px;
}

QListView::item:selected {
	background-color: #1a3a4a;
	color: #FFFFFF;
}

/* QTextBrowser 文本浏览器样式 */
QTextBrowser {
	color: #a9b7c6;
	background-color: #000000;
	border: 1px solid #3a3a3a;
	selection-background-color: #1a3a4a;
	selection-color: #FFFFFF;
}

/* QCalendarWidget 日历控件样式 */
QCalendarWidget {
	color: #a9b7c6;
	background-color: #000000;
}

QCalendarWidget QAbstractItemView {
	color: #a9b7c6;
	background-color: #1a1a1a;
	selection-background-color: #e67e22;
	selection-color: #000000;
}

QCalendarWidget QToolButton {
	color: #a9b7c6;
	background-color: #1a1a1a;
	border: 1px solid #3a3a3a;
}

QCalendarWidget QToolButton:hover {
	background-color: #e67e22;
	color: #000000;
}

QCalendarWidget #qt_calendar_navigationbar {
	background-color: #1a1a1a;
	border-bottom: 1px solid #3a3a3a;
}

/* QDial 旋转拨盘样式 */
QDial {
	color: #a9b7c6;
	background-color: #000000;
}

QDial::groove {
	background-color: #1a1a1a;
	border: 1px solid #3a3a3a;
}

QDial::handle {
	background-color: #e67e22;
	border: 2px solid #3a3a3a;
	width: 16px;
	height: 16px;
	margin: -5px;
	border-radius: 8px;
}

QDial::handle:hover {
	background-color: #f39c12;
}

/* QProgressIndicator 进度指示器样式 */
QProgressIndicator {
	color: #a9b7c6;
}

/* QSizeGrip 大小调整手柄样式 */
QSizeGrip {
	background-color: transparent;
	image: url(qss/sizegrip.png);
	width: 16px;
	height: 16px;
}

/* QToolTip 提示框样式 */
QToolTip {
	color: #a9b7c6;
	background-color: #1a1a1a;
	border: 1px solid #e67e22;
	border-radius: 4px;
	padding: 4px 8px;
}

/* QSplitterHandle 拖拽手柄样式 */
QSplitterHandle {
	background-color: #1a1a1a;
}

QSplitterHandle:hover {
	background-color: #e67e22;
}