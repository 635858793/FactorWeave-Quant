QFrame {
   background-color: rgb(79, 149, 255);
   color:black;
   font: 75 12pt "Century Schoolbook L";

}

QMainWindow{
    background-color: rgb(79, 149, 255);
    color:black;
    border-style: solid;
    border-radius: 10;
    font: 75 12pt "Century Schoolbook L";
}

QWidget{

    background-color: rgb(79, 149, 255);
    color:black;
    border-style: solid;
    border-radius: 10;
    font: 75 12pt "Century Schoolbook L";

}

QMenu{
    color:white;   
    background-color: rgb(79, 149, 255);
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 8;
    padding: 5px;
    font: italic 12pt "URW Chancery L";
    
}

QSpinBox{
    background-color: white;
    color:black;
    border-radius: 5;
    padding: 3px;
    min-width: 9ex;
    min-height: 2.5ex;
    font: 75 12pt "Century Schoolbook L";

}


QTreeView{
    color:black;
    background-color: rgb(79, 149, 255);
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 10;
    font: 75 12pt "Century Schoolbook L";
}

QComboBox{
    background-color: yellowgreen;
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 5;
    font: italic 12pt "URW Chancery L";
}
QComboBox:hover{
   background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(130, 111, 111, 255), stop:1 rgba(255, 255, 255, 255));
}


QPushButton {
    color:black;
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 10;
    padding: 3px;
    min-width: 9ex;
    min-height: 25px;
    font: 75 12pt "Century Schoolbook L";
}

QPushButton:hover {
   background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(130, 111, 111, 255), stop:1 rgba(255, 255, 255, 255));
}

/**********对话框按钮组**********/
QDialogButtonBox {
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
    border: none;
}
QDialogButtonBox QPushButton {
    color:black;
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 10;
    padding: 3px;
    min-width: 9ex;
    min-height: 25px;
    font: 75 12pt "Century Schoolbook L";
}
QDialogButtonBox QPushButton:hover {
    color:black;
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(130, 111, 111, 255), stop:1 rgba(255, 255, 255, 255));
}
QDialogButtonBox QPushButton:pressed {
    padding-left: 5px;
    padding-top: 5px;
    color:black;
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
}
QDialogButtonBox QPushButton:disabled {
    color:black;
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
    border-color: rgb(150, 150, 150);
}
QDialogButtonBox QPushButton:default {
    color:black;
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
    border-color: rgb(100, 100, 100);
}

QPushButton:pressed {
    padding-left: 5px;
    padding-top: 5px;
    background-color:  qlineargradient(spread:reflect, x1:0.908727, y1:0.069, x2:1, y2:0, stop:0 rgba(53, 85, 11, 255), stop:1 rgba(255, 255, 255, 255));
}

QLineEdit{
   
   background-color: white; 
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 10;
    padding: 3px;
}



QLabel {
    color:white; 
}



QDoubleSpinBox {
    color:white;
    background-color: yellowgreen;
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius:5;

}


QCheckBox{
    color:black;
    background-color: qlineargradient(spread:pad, x1:0.536868, y1:0, x2:0.524, y2:1, stop:0 rgba(90, 90, 90, 255), stop:0.51752 rgba(255, 255, 255, 255), stop:1 rgba(0, 0, 0, 255));
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 5;
    padding: 3px;
    min-width: 9ex;
    min-height: 2.5ex;
}
QCheckBox:hover{
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(130, 111, 111, 255), stop:1 rgba(255, 255, 255, 255));
}
QCheckBox:checked{
    color: rgb(12, 1, 170);
}
QCheckBox::indicator {
        width: 18px;
        height: 18px;
        border: 2px solid seagreen;
        border-radius: 3px;
        background: yellowgreen;
}
QCheckBox::indicator:checked {
        background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 yellowgreen, stop:1 seagreen);
}
QCheckBox::indicator:hover {
        border-color: #7CCD7C;
}


QRadioButton{
    color:white;
    background-color: yellowgreen;
    border-width: 2px;
    border-color: seagreen;
    border-style: solid;
    border-radius: 10;
    padding: 3px;
}
QRadioButton:checked {
	color: rgb(12, 1, 170);
}
QRadioButton::indicator {
        width: 18px;
        height: 18px;
        border: 2px solid seagreen;
        border-radius: 9px;
        background: yellowgreen;
}
QRadioButton::indicator:checked {
        background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 yellowgreen, stop:1 seagreen);
}
QRadioButton::indicator:hover {
        border-color: #7CCD7C;
}
QRadioButton:hover {
    color:white;
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(130, 111, 111, 255), stop:1 rgba(255, 255, 255, 255));
}

/**********菜单栏**********/
QMenuBar {
        background-color: rgb(79, 149, 255);
        color: white;
        font: italic 12pt "URW Chancery L";
        padding: 5px;
}
QMenuBar::item {
        padding: 5px 10px;
        background: transparent;
        border-radius: 4px;
}
QMenuBar::item:selected {
        background-color: yellowgreen;
        color: black;
}
QMenuBar::item:pressed {
        background-color: seagreen;
}

/**********状态栏**********/
QStatusBar {
        background-color: rgb(79, 149, 255);
        color: white;
        font: 75 12pt "Century Schoolbook L";
}
QStatusBar::item {
        border: none;
        border-right: 1px solid seagreen;
}

/**********滑块-水平**********/
QSlider::groove:horizontal {
        height: 8px;
        background: rgb(100, 160, 255);
        border-radius: 4px;
}
QSlider::handle:horizontal {
        width: 20px;
        height: 20px;
        background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 yellowgreen, stop:1 seagreen);
        border-radius: 10px;
        margin: -6px 0;
}
QSlider::handle:horizontal:hover {
        background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 #7CCD7C, stop:1 #3CB371);
}
QSlider::add-page:horizontal {
        background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 yellowgreen, stop: 1 seagreen);
        border-radius: 5px;
}
QSlider::sub-page:horizontal {
        background: rgb(100, 160, 255);
        border-radius: 5px;
}

/**********滑块-垂直**********/
QSlider::groove:vertical {
        width: 8px;
        background: rgb(100, 160, 255);
        border-radius: 4px;
}
QSlider::handle:vertical {
        width: 20px;
        height: 20px;
        background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 yellowgreen, stop:1 seagreen);
        border-radius: 10px;
        margin: 0 -6px;
}
QSlider::handle:vertical:hover {
        background: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 #7CCD7C, stop:1 #3CB371);
}
QSlider::add-page:vertical {
        background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 yellowgreen, stop: 1 seagreen);
        border-radius: 5px;
}
QSlider::sub-page:vertical {
        background: rgb(100, 160, 255);
        border-radius: 5px;
}

/**********进度条**********/
QProgressBar {
        border: 2px solid seagreen;
        border-radius: 8px;
        text-align: center;
        color: black;
        background-color: rgb(79, 149, 255);
        font: 75 12pt "Century Schoolbook L";
}
QProgressBar::chunk {
        background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 yellowgreen, stop: 1 seagreen);
        border-radius: 6px;
}

/**********标签页**********/
QTabWidget::pane {
        border: 2px solid seagreen;
        background: rgb(79, 149, 255);
        border-top: 3px solid yellowgreen;
        border-radius: 8px;
}
QTabBar::tab {
        background: rgb(100, 160, 255);
        color: white;
        padding: 8px 15px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        font: 75 12pt "Century Schoolbook L";
}
QTabBar::tab:selected {
        background: rgb(79, 149, 255);
        color: black;
        border-top: 3px solid yellowgreen;
}
QTabBar::tab:hover:!selected {
        background: yellowgreen;
}

/**********表头**********/
QHeaderView {
        background-color: yellowgreen;
        border: 1px solid seagreen;
        font: 75 12pt "Century Schoolbook L";
}
QHeaderView::section {
        background: yellowgreen;
        color: black;
        padding: 5px;
        border: 1px solid seagreen;
        border-radius: 4px;
}
QHeaderView::section:hover {
        background: seagreen;
        color: white;
}

/**********表格视图**********/
QTableView {
        gridline-color: seagreen;
        background: rgb(79, 149, 255);
        border: 2px solid seagreen;
        border-radius: 10px;
        font: 75 12pt "Century Schoolbook L";
}
QTableView::item {
        color: black;
        background: rgb(100, 160, 255);
        border: 1px solid seagreen;
        padding: 3px;
}
QTableView::item:selected {
        background: yellowgreen;
        color: black;
}

/**********列表控件**********/
QListWidget {
        background: rgb(79, 149, 255);
        border: 2px solid seagreen;
        border-radius: 10px;
        font: 75 12pt "Century Schoolbook L";
}
QListWidget::item {
        color: black;
        background: rgb(100, 160, 255);
        padding: 8px;
        border: 1px solid seagreen;
        border-radius: 5px;
}
QListWidget::item:selected {
        background: yellowgreen;
        color: black;
}

/**********滚动条**********/
QScrollBar:horizontal {
        height: 14px;
        background: rgb(100, 160, 255);
        border-radius: 7px;
}
QScrollBar::handle:horizontal {
        background: yellowgreen;
        border-radius: 6px;
        min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
        background: seagreen;
}
QScrollBar:vertical {
        width: 14px;
        background: rgb(100, 160, 255);
        border-radius: 7px;
}
QScrollBar::handle:vertical {
        background: yellowgreen;
        border-radius: 6px;
        min-height: 30px;
}
QScrollBar::handle:vertical:hover {
        background: seagreen;
}

/**********文本编辑框**********/
QTextEdit {
        border: 2px solid seagreen;
        border-radius: 10px;
        color: black;
        background: white;
        font: 75 12pt "Century Schoolbook L";
}

/**********文本浏览器**********/
QTextBrowser {
        border: 2px solid seagreen;
        border-radius: 10px;
        color: black;
        background: white;
        font: 75 12pt "Century Schoolbook L";
}

/**********分组框**********/
QGroupBox {
        border: 2px solid seagreen;
        border-radius: 8px;
        margin-top: 15px;
        padding-top: 10px;
        color: black;
        font: 75 bold 13pt "Century Schoolbook L";
}
QGroupBox::title {
        subcontrol-origin: margin;
        left: 10px;
        color: seagreen;
}

/**********工具栏**********/
QToolBar {
        background: rgb(79, 149, 255);
        border: 1px solid seagreen;
        border-radius: 8px;
        spacing: 5px;
        padding: 3px;
}
QToolBar::separator {
        width: 1px;
        background: seagreen;
}
QToolBar::handle {
        background: seagreen;
}

/**********停靠窗口**********/
QDockWidget {
        border: 2px solid seagreen;
        background: rgb(79, 149, 255);
        border-radius: 8px;
}
QDockWidget::title {
        background: yellowgreen;
        padding: 5px 10px;
        color: black;
        font: italic 12pt "URW Chancery L";
}
QDockWidget::close-button, QDockWidget::float-button {
        background: transparent;
        border: none;
}
QDockWidget::separator {
        background: seagreen;
}

/**********堆叠窗口**********/
QStackedWidget {
        background: rgb(79, 149, 255);
        border-radius: 10px;
}

/**********日历控件**********/
QCalendarWidget QAbstractItemView {
        background: rgb(79, 149, 255);
        color: black;
        selection-background-color: yellowgreen;
        selection-color: black;
        border: 2px solid seagreen;
        border-radius: 8px;
        font: 75 12pt "Century Schoolbook L";
}

/**********拨盘**********/
QDial {
        background: rgb(100, 160, 255);
        border-radius: 50px;
}
QDial::groove {
        background: seagreen;
        border-radius: 50px;
}
QDial::handle {
        width: 24px;
        height: 24px;
        background: yellowgreen;
        border-radius: 12px;
}

/**********LCD数字显示**********/
QLCDNumber {
        background: rgb(79, 149, 255);
        color: yellowgreen;
        border: 2px solid seagreen;
        border-radius: 8px;
}

/**********字体选择框**********/
QFontComboBox {
        border: 2px solid seagreen;
        border-radius: 5px;
        padding: 3px;
        background: yellowgreen;
        font: italic 12pt "URW Chancery L";
}
QFontComboBox::drop-down {
        width: 20px;
        background: transparent;
}
QFontComboBox QAbstractItemView {
        background: rgb(79, 149, 255);
        color: black;
        border: 1px solid seagreen;
}
QFontComboBox QAbstractItemView::item:selected {
        background: yellowgreen;
        color: black;
}

/**********日期时间编辑框**********/
QDateEdit, QTimeEdit {
        border: 2px solid seagreen;
        border-radius: 5px;
        padding: 3px 5px;
        background: white;
        color: black;
        font: 75 12pt "Century Schoolbook L";
}
QDateEdit::drop-down, QTimeEdit::drop-down {
        width: 20px;
        background: yellowgreen;
}
QDateTimeEdit {
        border: 2px solid seagreen;
        border-radius: 5px;
        padding: 3px 5px;
        background: white;
        color: black;
        font: 75 12pt "Century Schoolbook L";
}
QDateTimeEdit::drop-down {
        width: 20px;
        background: yellowgreen;
}

/**********工具提示**********/
QToolTip {
        border: 2px solid seagreen;
        background: white;
        color: black;
        padding: 5px;
        border-radius: 4px;
        font: 75 11pt "Century Schoolbook L";
}

/**********框架扩展**********/
QFrame#infoFrame {
        border: 2px solid seagreen;
        background: rgb(100, 160, 255);
        border-radius: 8px;
}
QFrame[frameShape="4"] {
        background: seagreen;
        max-height: 2px;
}
QFrame[frameShape="5"] {
        background: seagreen;
        max-width: 2px;
}

/**********分割器**********/
QSplitter::handle {
        background: seagreen;
}
QSplitter::handle:horizontal {
        width: 8px;
        border-radius: 4px;
}
QSplitter::handle:vertical {
        height: 8px;
        border-radius: 4px;
}
QSplitter::handle:hover {
        background: yellowgreen;
}

/**********进度指示器**********/
QProgressIndicator {
        qproperty-color: yellowgreen;
}

/**********分页控件**********/
QPushButton#pageButton {
        min-width: 30px;
        padding: 5px 10px;
        border-radius: 5px;
}
QPushButton#pageButton:checked {
        background: yellowgreen;
        color: black;
}

/**********滚动区域**********/
QScrollArea {
        border: 2px solid seagreen;
        background: rgb(79, 149, 255);
        border-radius: 10px;
}

/**********主窗口扩展**********/
QMainWindow::separator {
        background: seagreen;
        width: 4px;
        height: 4px;
        border-radius: 2px;
}
QMainWindow::separator:hover {
        background: yellowgreen;
}

