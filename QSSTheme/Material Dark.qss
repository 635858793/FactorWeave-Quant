/*
Material Dark Style Sheet for QT Applications
Author: Jaime A. Quiroga P.
Inspired on https://github.com/jxfwinter/qt-material-stylesheet
Company: GTRONICK
Last updated: 04/12/2018, 15:00.
Available at: https://github.com/GTRONICK/QSS/blob/master/MaterialDark.qss
*/
QMainWindow {
	background-color: #1e1d23;
}

QDialog {
	background-color: #1e1d23;
}

QColorDialog {
	background-color: #1e1d23;
}

QTextEdit {
	background-color: #1e1d23;
	color: #a9b7c6;
}

QPlainTextEdit {
	selection-background-color: #007b50;
	background-color: #1e1d23;
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	color: #a9b7c6;
}

QPushButton {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #1e1d23;
}

QPushButton::default {
	border-style: inset;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #04b97f;
	border-width: 1px;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #1e1d23;
}

QToolButton {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #04b97f;
	border-bottom-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #1e1d23;
}

QToolButton:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #37efba;
	border-bottom-width: 2px;
	border-style: solid;
	color: #FFFFFF;
	padding-bottom: 1px;
	background-color: #1e1d23;
}

QPushButton:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #37efba;
	border-bottom-width: 1px;
	border-style: solid;
	color: #FFFFFF;
	padding-bottom: 2px;
	background-color: #1e1d23;
}

QPushButton:pressed {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #37efba;
	border-bottom-width: 2px;
	border-style: solid;
	color: #37efba;
	padding-bottom: 1px;
	background-color: #1e1d23;
}

QPushButton:disabled {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #808086;
	border-bottom-width: 2px;
	border-style: solid;
	color: #808086;
	padding-bottom: 1px;
	background-color: #1e1d23;
}

/**********对话框按钮组**********/
QDialogButtonBox {
	background: #1e1d23;
	border: none;
}

QDialogButtonBox QPushButton {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	min-height: 25px;
	background-color: #1e1d23;
}

QDialogButtonBox QPushButton:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-width: 1px;
	color: #a9b7c6;
	padding: 2px;
	background-color: #1e1d23;
}

QDialogButtonBox QPushButton:pressed {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding: 2px;
	background-color: #1e1d23;
}

QDialogButtonBox QPushButton:disabled {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #808086;
	border-bottom-width: 2px;
	border-style: solid;
	color: #808086;
	padding-bottom: 1px;
	background-color: #1e1d23;
}

QDialogButtonBox QPushButton:default {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #e67e22;
	border-width: 1px;
	color: #a9b7c6;
	padding: 2px;
	background-color: #1e1d23;
}

QLineEdit {
	border-width: 1px;
	border-radius: 4px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	padding: 0 8px;
	color: #a9b7c6;
	background: #1e1d23;
	selection-background-color: #007b50;
	selection-color: #FFFFFF;
}

QLabel {
	color: #a9b7c6;
}

QLCDNumber {
	color: #37e6b4;
}

QProgressBar {
	text-align: center;
	color: rgb(240, 240, 240);
	border-width: 1px;
	border-radius: 10px;
	border-color: rgb(58, 58, 58);
	border-style: inset;
	background-color: #1e1d23;
}

QProgressBar::chunk {
	background-color: #04b97f;
	border-radius: 5px;
}

QMenuBar {
	background-color: #1e1d23;
}

QMenuBar::item {
	color: #a9b7c6;
	spacing: 3px;
	padding: 1px 4px;
	background: #1e1d23;
}

QMenuBar::item:selected {
	background: #1e1d23;
	color: #FFFFFF;
}

QMenu::item:selected {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: #04b97f;
	border-bottom-color: transparent;
	border-left-width: 2px;
	color: #FFFFFF;
	padding-left: 15px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 7px;
	background-color: #1e1d23;
}

QMenu::item {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-bottom-width: 1px;
	border-style: solid;
	color: #a9b7c6;
	padding-left: 17px;
	padding-top: 4px;
	padding-bottom: 4px;
	padding-right: 7px;
	background-color: #1e1d23;
}

QMenu {
	background-color: #1e1d23;
}

QTabWidget {
	color: rgb(0, 0, 0);
	background-color: #1e1d23;
}

QTabWidget::pane {
	border-color: rgb(77, 77, 77);
	background-color: #1e1d23;
	border-style: solid;
	border-width: 1px;
	border-radius: 6px;
}

QTabBar::tab {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: transparent;
	border-bottom-width: 1px;
	border-style: solid;
	color: #808086;
	padding: 3px;
	margin-left: 3px;
	background-color: #1e1d23;
}

QTabBar::tab:selected,
QTabBar::tab:last:selected,
QTabBar::tab:hover {
	border-style: solid;
	border-top-color: transparent;
	border-right-color: transparent;
	border-left-color: transparent;
	border-bottom-color: #04b97f;
	border-bottom-width: 2px;
	border-style: solid;
	color: #FFFFFF;
	padding-left: 3px;
	padding-bottom: 2px;
	margin-left: 3px;
	background-color: #1e1d23;
}

QCheckBox {
	color: #a9b7c6;
	padding: 2px;
}

QCheckBox:disabled {
	color: #808086;
	padding: 2px;
}

QCheckBox:hover {
	border-radius: 4px;
	border-style: solid;
	padding-left: 1px;
	padding-right: 1px;
	padding-bottom: 1px;
	padding-top: 1px;
	border-width: 1px;
	border-color: rgb(87, 97, 106);
	background-color: #1e1d23;
}

QCheckBox::indicator:checked {

	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: #04b97f;
	color: #a9b7c6;
	background-color: #04b97f;
}

QCheckBox::indicator:unchecked {

	height: 18px;
	width: 18px;
	border-style: solid;
	border-width: 1px;
	border-color: #04b97f;
	color: #a9b7c6;
	background-color: transparent;
}

QRadioButton {
	color: #a9b7c6;
	background-color: #1e1d23;
	padding: 1px;
}

QRadioButton::indicator:checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-radius: 9px;
	border-width: 1px;
	border-color: #04b97f;
	color: #a9b7c6;
	background-color: #04b97f;
}

QRadioButton::indicator:!checked {
	height: 18px;
	width: 18px;
	border-style: solid;
	border-radius: 9px;
	border-width: 1px;
	border-color: #04b97f;
	color: #a9b7c6;
	background-color: transparent;
}

QStatusBar {
	color: #027f7f;
}

QSpinBox {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QDoubleSpinBox {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QTimeEdit {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QDateTimeEdit {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QDateEdit {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QComboBox {
	color: #a9b7c6;
	background: #1e1d23;
}

QComboBox:editable {
	background: #1e1d23;
	color: #a9b7c6;
	selection-background-color: #1e1d23;
}

QComboBox QAbstractItemView {
	color: #a9b7c6;
	background: #1e1d23;
	selection-color: #FFFFFF;
	selection-background-color: #1e1d23;
}

QComboBox:!editable:on,
QComboBox::drop-down:editable:on {
	color: #a9b7c6;
	background: #1e1d23;
}

QFontComboBox {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QToolBox {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QToolBox::tab {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QToolBox::tab:selected {
	color: #FFFFFF;
	background-color: #1e1d23;
}

QScrollArea {
	color: #FFFFFF;
	background-color: #1e1d23;
}

QSlider::groove:horizontal {
	height: 8px;
	background: #04b97f;
}

QSlider::groove:vertical {
	width: 8px;
	background: #04b97f;
}

QSlider::handle:horizontal {
	background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #b4b4b4, stop:1 #8f8f8f);
	border: 1px solid #5c5c5c;
	width: 20px;
	height: 20px;
	margin: -6px 0;
	border-radius: 10px;
}

QSlider::handle:vertical {
	background: qlineargradient(x1:1, y1:1, x2:0, y2:0, stop:0 #b4b4b4, stop:1 #8f8f8f);
	border: 1px solid #5c5c5c;
	width: 20px;
	height: 20px;
	margin: 0 -6px;
	border-radius: 10px;
}

QSlider::add-page:horizontal {
	background: white;
}

QSlider::add-page:vertical {
	background: white;
}

QSlider::sub-page:horizontal {
	background: #04b97f;
}

QSlider::sub-page:vertical {
	background: #04b97f;
}

/* QFrame 框架样式 */
QFrame {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QFrame#infoFrame {
	border: 1px solid #3a3a3a;
	border-radius: 4px;
	margin: 4px;
	padding: 4px;
}

/* QGroupBox 分组框样式 */
QGroupBox {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
	margin-top: 1.2em;
	padding-top: 10px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 5px;
	color: #a9b7c6;
}

QGroupBox::indicator {
	width: 12px;
	height: 12px;
	border-radius: 3px;
}

QGroupBox::indicator:unchecked {
	border: 1px solid #3a3a3a;
	background-color: transparent;
}

QGroupBox::indicator:checked {
	border: 1px solid #04b97f;
	background-color: #04b97f;
}

/* QSplitter 分裂器样式 */
QSplitter {
	background-color: #1e1d23;
}

QSplitter::handle {
	background-color: #2a2a30;
	border: 1px solid #3a3a3a;
}

QSplitter::handle:horizontal {
	width: 4px;
	margin: 2px;
}

QSplitter::handle:vertical {
	height: 4px;
	margin: 2px;
}

QSplitter::handle:hover {
	background-color: #04b97f;
}

/* QToolBar 工具栏样式 */
QToolBar {
	background-color: #1e1d23;
	border-bottom: 1px solid #3a3a3a;
	spacing: 3px;
	padding: 2px;
}

QToolBar::separator {
	width: 1px;
	background-color: #3a3a3a;
	margin: 2px;
}

QToolBar QToolButton {
	background-color: transparent;
	border: 1px solid transparent;
	border-radius: 3px;
	padding: 3px;
}

QToolBar QToolButton:hover {
	background-color: #2a2a30;
	border: 1px solid #04b97f;
}

QToolBar QToolButton:pressed {
	background-color: #04b97f;
}

/* QDockWidget 停靠窗口样式 */
QDockWidget {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QDockWidget::title {
	text-align: center;
	background-color: #25252a;
	border: 1px solid #3a3a3a;
	border-radius: 3px;
	padding: 4px;
}

QDockWidget::close-button {
	background-color: #25252a;
	border-radius: 2px;
}

QDockWidget::close-button:hover {
	background-color: #e74c3c;
}

QDockWidget::float-button {
	background-color: #25252a;
	border-radius: 2px;
}

QDockWidget::float-button:hover {
	background-color: #3498db;
}

QDockWidget::separator {
	background-color: #3a3a3a;
	width: 1px;
	height: 1px;
}

QDockWidget QWidget {
	background-color: #1e1d23;
}

/* QStackedWidget 堆叠窗口样式 */
QStackedWidget {
	background-color: #1e1d23;
}

QStackedWidget QWidget {
	background-color: #1e1d23;
}

/* QTableWidget 表格样式 */
QTableWidget {
	gridline-color: #3a3a3a;
	color: #a9b7c6;
	background-color: #1e1d23;
	alternate-background-color: #25252a;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QTableWidget::item {
	padding: 4px;
	border: 1px solid transparent;
}

QTableWidget::item:selected {
	background-color: #04b97f;
	color: #FFFFFF;
}

QTableWidget::item:hover {
	background-color: #2a2a30;
}

QTableWidget QHeaderView {
	background-color: #25252a;
}

QTableWidget QHeaderView::section {
	background-color: #25252a;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
	padding: 4px;
	font-weight: bold;
}

QTableWidget QHeaderView::section:checked {
	background-color: #04b97f;
}

/* QTableView 表格视图样式 */
QTableView {
	gridline-color: #3a3a3a;
	color: #a9b7c6;
	background-color: #1e1d23;
	alternate-background-color: #25252a;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QTableView::item {
	padding: 4px;
	border: 1px solid transparent;
}

QTableView::item:selected {
	background-color: #04b97f;
	color: #FFFFFF;
}

QTableView QHeaderView {
	background-color: #25252a;
}

QTableView QHeaderView::section {
	background-color: #25252a;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
	padding: 4px;
	font-weight: bold;
}

/* QHeaderView 表头视图样式 */
QHeaderView {
	background-color: #25252a;
}

QHeaderView::section {
	background-color: #25252a;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
	padding: 4px 8px;
	font-weight: bold;
}

QHeaderView::section:first {
	border-left: 1px solid #25252a;
}

QHeaderView::section:last {
	border-right: 1px solid #25252a;
}

QHeaderView::section:checked {
	background-color: #04b97f;
}

QHeaderView::section:hover {
	background-color: #2a2a30;
}

QHeaderView::down-arrow {
	image: url(./icons/down.png);
	width: 12px;
	height: 12px;
}

QHeaderView::up-arrow {
	image: url(./icons/up.png);
	width: 12px;
	height: 12px;
}

/* QTreeWidget 树形控件样式 */
QTreeWidget {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QTreeWidget::item {
	padding: 3px;
	margin: 1px;
}

QTreeWidget::item:selected {
	background-color: #04b97f;
	color: #FFFFFF;
}

QTreeWidget::item:hover {
	background-color: #2a2a30;
}

QTreeWidget::branch {
	background-color: #1e1d23;
}

QTreeWidget::branch:has-children:closed {
	image: url(./icons/branch-closed.png);
}

QTreeWidget::branch:has-children:open {
	image: url(./icons/branch-open.png);
}

QTreeWidget::branch:has-children:closed:hover {
	image: url(./icons/branch-closed-hover.png);
}

QTreeWidget::branch:has-children:open:hover {
	image: url(./icons/branch-open-hover.png);
}

QTreeWidget QHeaderView {
	background-color: #25252a;
}

QTreeWidget QHeaderView::section {
	background-color: #25252a;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
	padding: 4px;
	font-weight: bold;
}

/* QTreeView 树形视图样式 */
QTreeView {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QTreeView::item {
	padding: 3px;
	margin: 1px;
}

QTreeView::item:selected {
	background-color: #04b97f;
	color: #FFFFFF;
}

QTreeView::item:hover {
	background-color: #2a2a30;
}

QTreeView::branch {
	background-color: #1e1d23;
}

QTreeView::branch:has-children:closed {
	image: url(./icons/branch-closed.png);
}

QTreeView::branch:has-children:open {
	image: url(./icons/branch-open.png);
}

QTreeView QHeaderView {
	background-color: #25252a;
}

QTreeView QHeaderView::section {
	background-color: #25252a;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
	padding: 4px;
	font-weight: bold;
}

/* QListWidget 列表控件样式 */
QListWidget {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QListWidget::item {
	padding: 6px;
	margin: 1px;
	border-radius: 3px;
}

QListWidget::item:selected {
	background-color: #04b97f;
	color: #FFFFFF;
}

QListWidget::item:hover {
	background-color: #2a2a30;
}

/* QListView 列表视图样式 */
QListView {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QListView::item {
	padding: 6px;
	margin: 1px;
	border-radius: 3px;
}

QListView::item:selected {
	background-color: #04b97f;
	color: #FFFFFF;
}

QListView::item:hover {
	background-color: #2a2a30;
}

/* QTextBrowser 文本浏览器样式 */
QTextBrowser {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QTextBrowser:hover {
	border-color: #04b97f;
}

/* QCalendarWidget 日历控件样式 */
QCalendarWidget {
	color: #a9b7c6;
	background-color: #1e1d23;
}

QCalendarWidget QToolButton {
	background-color: #1e1d23;
	color: #a9b7c6;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
	padding: 4px;
}

QCalendarWidget QToolButton:hover {
	background-color: #04b97f;
	color: #FFFFFF;
}

QCalendarWidget QToolButton::menu-indicator {
	image: none;
}

QCalendarWidget QSpinBox {
	color: #a9b7c6;
	background-color: #1e1d23;
	border: 1px solid #3a3a3a;
	border-radius: 4px;
}

QCalendarWidget #qt_calendar_navigationbar {
	background-color: #25252a;
}

QCalendarWidget #qt_calendar_prevmonth {
	qproperty-icon: url(./icons/left.png);
}

QCalendarWidget #qt_calendar_nextmonth {
	qproperty-icon: url(./icons/right.png);
}

QCalendarWidget QAbstractItemView:enabled {
	color: #a9b7c6;
	background-color: #1e1d23;
	selection-background-color: #04b97f;
	selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
	color: #808086;
}

/* QDial 拨号盘样式 */
QDial {
	background-color: #1e1d23;
}

QDial::groove {
	background-color: #3a3a3a;
	border-radius: 4px;
}

QDial::handle {
	background-color: #04b97f;
	border-radius: 6px;
	border: 2px solid #3a3a3a;
}

QDial::handle:hover {
	background-color: #37efba;
}

QDial::handle:pressed {
	background-color: #37efba;
	border-color: #04b97f;
}

/* QProgressIndicator 进度指示器样式 */
QProgressBar:indeterminate {
	background-color: #3a3a3a;
}

/* QSizeGrip 大小调整手柄样式 */
QSizeGrip {
	width: 14px;
	height: 14px;
	image: url(./icons/sizegrip.png);
	background-color: transparent;
}

/* QToolTip 工具提示样式 */
QToolTip {
	color: #a9b7c6;
	background-color: #25252a;
	border: 1px solid #04b97f;
	border-radius: 4px;
	padding: 4px 8px;
}

/* QSplitterHandle 分裂器手柄样式 */
QSplitterHandle {
	background-color: #2a2a30;
}

QSplitterHandle:hover {
	background-color: #04b97f;
}