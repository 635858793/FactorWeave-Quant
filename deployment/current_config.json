{
  "environment": "development",
  "database": {
    "duckdb_path": "./data/factorweave.duckdb",
    "duckdb_memory_limit": "4GB",
    "duckdb_threads": 4,
    "duckdb_max_memory": "8GB",
    "connection_pool_size": 10,
    "connection_timeout": 30,
    "backup_enabled": true,
    "backup_interval": 3600,
    "backup_retention": 7,
    "backup_path": "./backups"
  },
  "cache": {
    "l1_memory": {
      "enabled": true,
      "strategy": "adaptive",
      "max_size": 10000
    },
    "l2_disk": {
      "enabled": true,
      "cache_dir": "./cache",
      "max_size_mb": 2048
    },
    "l3_distributed": {
      "enabled": false
    }
  },
  "logging": {
    "level": "DEBUG",
    "handlers": [
      {
        "sink": "sys.stdout",
        "level": "DEBUG",
        "format": "<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>",
        "colorize": true
      },
      {
        "sink": "./logs/factorweave.log",
        "level": "DEBUG",
        "format": "<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>",
        "rotation": "100 MB",
        "retention": "30 days",
        "compression": "gz",
        "enqueue": true
      }
    ],
    "performance_enabled": true,
    "slow_query_threshold": 1.0
  },
  "performance": {
    "max_workers": 8,
    "thread_pool_size": 16,
    "async_enabled": true,
    "event_loop_policy": "asyncio",
    "memory_limit_mb": 4096,
    "gc_threshold": 1000,
    "batch_size": 1000,
    "chunk_size": 10000,
    "request_timeout": 30,
    "connection_pool_size": 100,
    "cache_warmup_enabled": true,
    "warmup_data_size": 10000
  },
  "security": {
    "api_key_required": false,
    "api_key": null,
    "encryption_enabled": false,
    "encryption_key": null,
    "allowed_hosts": [
      "localhost",
      "127.0.0.1"
    ],
    "cors_enabled": true,
    "cors_origins": [
      "*"
    ],
    "rate_limit_enabled": true,
    "rate_limit_requests": 1000,
    "rate_limit_window": 3600,
    "ssl_enabled": false,
    "ssl_cert_path": null,
    "ssl_key_path": null
  },
  "monitoring": {
    "health_check_enabled": true,
    "health_check_interval": 60,
    "metrics_enabled": true,
    "metrics_port": 9090,
    "prometheus_enabled": false,
    "prometheus_endpoint": "/metrics",
    "alerting_enabled": false,
    "alert_webhook_url": null,
    "cpu_threshold": 80.0,
    "memory_threshold": 85.0,
    "disk_threshold": 90.0,
    "error_rate_threshold": 5.0,
    "response_time_threshold": 2.0
  },
  "ui": {
    "host": "0.0.0.0",
    "port": 8080,
    "debug": true,
    "theme": "dark",
    "language": "zh_CN",
    "enable_compression": true,
    "cache_static_files": true,
    "enable_realtime": true,
    "enable_advanced_charts": true,
    "enable_data_export": true
  },
  "plugin": {
    "plugin_dirs": [
      "./plugins"
    ],
    "auto_load": true,
    "load_timeout": 30,
    "sandbox_enabled": true,
    "allowed_modules": [
      "pandas",
      "numpy",
      "requests"
    ],
    "max_memory_mb": 512,
    "max_execution_time": 60
  }
}