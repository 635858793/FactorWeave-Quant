# 应用配置
APP_NAME=Hikyuu UI
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码配置
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_HISTORY_COUNT=5

# 2FA配置
TWO_FA_ENABLED=True
TWO_FA_ISSUER=Hikyuu UI

# 会话配置
SESSION_TIMEOUT_MINUTES=30

# 账户锁定配置
ACCOUNT_LOCK_ENABLED=True
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# 限流配置
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log

# Redis配置
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 数据加密配置
DATA_ENCRYPTION_ENABLED=True
DATA_ENCRYPTION_FIELDS=password,api_secret,two_fa_secret
ENCRYPTION_KEY=your-encryption-key-change-in-production

# Hikyuu 专用加密密钥
HIKYUU_ENCRYPTION_KEY=your-hikyuu-encryption-key-change-in-production
HIKYUU_ENCRYPTION_SALT=your-hikyuu-salt-change-in-production

# 安全配置
SECURITY_IP_WHITELIST_ENABLED=False
SECURITY_IP_BLACKLIST_ENABLED=False
SECURITY_REQUEST_SIGNATURE_ENABLED=False

# 数据库配置
DATABASE_URL=sqlite:///./data/databases/app.db
DUCKDB_PATH=data/databases/hikyuu.db

# 文件上传配置
UPLOAD_DIR=data/uploads
CHARTS_DIR=data/charts
EXPORTS_DIR=data/exports
BACKUPS_DIR=data/backups
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.json,.txt

# 数据源API配置
WIND_API_KEY=your-wind-api-key
FMP_API_KEY=your-fmp-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
EXORDE_API_KEY=your-exorde-api-key
DEFAULT_API_KEY=your-default-api-key

# API服务认证密钥
HIKYUU_API_KEY=dev-key-change-me
